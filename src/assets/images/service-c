<svg viewBox="0 0 1400 900" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&amp;display=swap');
    </style>

    <!-- Background -->
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#071820"/>
      <stop offset="100%" stop-color="#0d2e3d"/>
    </linearGradient>

    <!-- Central hub gradient -->
    <radialGradient id="hubGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="#4fdbaa" stop-opacity="0.35"/>
      <stop offset="50%"  stop-color="#3ec4d8" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#3ec4d8" stop-opacity="0"/>
    </radialGradient>

    <radialGradient id="hubCore" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="#4fdbaa"/>
      <stop offset="100%" stop-color="#2a9fb5"/>
    </radialGradient>

    <!-- Channel gradients -->
    <linearGradient id="voiceGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3ec4d8"/>
      <stop offset="100%" stop-color="#2a9fb5"/>
    </linearGradient>

    <linearGradient id="videoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4fdbaa"/>
      <stop offset="100%" stop-color="#3ec4d8"/>
    </linearGradient>

    <linearGradient id="msgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3ec4d8"/>
      <stop offset="100%" stop-color="#4fdbaa"/>
    </linearGradient>

    <linearGradient id="mobileGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4fdbaa"/>
      <stop offset="100%" stop-color="#2a9fb5"/>
    </linearGradient>

    <linearGradient id="panelGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#143d52"/>
      <stop offset="100%" stop-color="#0a2534"/>
    </linearGradient>

    <!-- Orbit ring gradient -->
    <linearGradient id="orbitGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%"   stop-color="#3ec4d8" stop-opacity="0.4"/>
      <stop offset="50%"  stop-color="#4fdbaa" stop-opacity="0.15"/>
      <stop offset="100%" stop-color="#3ec4d8" stop-opacity="0.4"/>
    </linearGradient>

    <!-- Filters -->
    <filter id="glow-hub" x="-80%" y="-80%" width="260%" height="260%">
      <feGaussianBlur stdDeviation="12" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <filter id="glow-node" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="5" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <filter id="glow-soft" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>

    <filter id="shadow">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.4"/>
    </filter>

    <!-- Animations -->
    <style>
      @keyframes floatUp {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-6px); }
      }
      @keyframes blink {
        0%, 100% { opacity: 0.4; }
        50%      { opacity: 1; }
      }
      @keyframes pulseHub {
        0%, 100% { r: 62; opacity: 0.15; }
        50%      { r: 75; opacity: 0.05; }
      }
      @keyframes pulseHub2 {
        0%, 100% { r: 90; opacity: 0.10; }
        50%      { r: 108; opacity: 0.03; }
      }
      @keyframes pulseHub3 {
        0%, 100% { r: 118; opacity: 0.07; }
        50%      { r: 138; opacity: 0.02; }
      }
      @keyframes orbitSpin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
      }
      @keyframes flowPulse {
        0%   { stroke-dashoffset: 50;  opacity: 0; }
        10%  { opacity: 0.8; }
        90%  { opacity: 0.8; }
        100% { stroke-dashoffset: -50; opacity: 0; }
      }
      @keyframes flowPulse2 {
        0%   { stroke-dashoffset: 50;  opacity: 0; }
        10%  { opacity: 0.6; }
        90%  { opacity: 0.6; }
        100% { stroke-dashoffset: -50; opacity: 0; }
      }
      @keyframes waveform {
        0%,100% { d: path("M0,0 Q5,-8 10,0 Q15,8 20,0 Q25,-8 30,0 Q35,8 40,0"); }
        50%     { d: path("M0,0 Q5,-12 10,0 Q15,12 20,0 Q25,-12 30,0 Q35,12 40,0"); }
      }
      @keyframes packetFlow {
        0%   { offset-distance: 0%;   opacity: 0; }
        5%   { opacity: 1; }
        95%  { opacity: 1; }
        100% { offset-distance: 100%; opacity: 0; }
      }
      @keyframes nodeFloat {
        0%, 100% { transform: translateY(0px) scale(1); }
        50%      { transform: translateY(-8px) scale(1.02); }
      }
      @keyframes ringPulse {
        0%   { stroke-width: 1;   opacity: 0.5; }
        50%  { stroke-width: 2;   opacity: 0.15; }
        100% { stroke-width: 1;   opacity: 0.5; }
      }
      @keyframes qualityBlink {
        0%, 100% { fill: #4fdbaa; }
        50%      { fill: #3ec4d8; }
      }

      .float  { animation: floatUp 4s ease-in-out infinite; }
      .float2 { animation: floatUp 4s ease-in-out infinite; animation-delay: 1s; }
      .float3 { animation: floatUp 4s ease-in-out infinite; animation-delay: 2s; }
      .float4 { animation: floatUp 4s ease-in-out infinite; animation-delay: 0.5s; }

      .blink  { animation: blink 1.8s ease-in-out infinite; }
      .blink2 { animation: blink 1.8s ease-in-out infinite; animation-delay: 0.45s; }
      .blink3 { animation: blink 1.8s ease-in-out infinite; animation-delay: 0.9s; }
      .blink4 { animation: blink 1.8s ease-in-out infinite; animation-delay: 1.35s; }

      .flow1  { animation: flowPulse  2s linear infinite; }
      .flow2  { animation: flowPulse  2s linear infinite; animation-delay: 0.4s; }
      .flow3  { animation: flowPulse  2s linear infinite; animation-delay: 0.8s; }
      .flow4  { animation: flowPulse  2s linear infinite; animation-delay: 1.2s; }
      .flow5  { animation: flowPulse2 2.4s linear infinite; animation-delay: 0.2s; }
      .flow6  { animation: flowPulse2 2.4s linear infinite; animation-delay: 0.7s; }
      .flow7  { animation: flowPulse2 2.4s linear infinite; animation-delay: 1.2s; }
      .flow8  { animation: flowPulse2 2.4s linear infinite; animation-delay: 1.7s; }

      .node-float  { animation: nodeFloat 4s ease-in-out infinite; }
      .node-float2 { animation: nodeFloat 4s ease-in-out infinite; animation-delay: 0.7s; }
      .node-float3 { animation: nodeFloat 4s ease-in-out infinite; animation-delay: 1.4s; }
      .node-float4 { animation: nodeFloat 4s ease-in-out infinite; animation-delay: 2.1s; }

      .ring-pulse { animation: ringPulse 3s ease-in-out infinite; }
      .quality    { animation: qualityBlink 2s ease-in-out infinite; }
    </style>
  </defs>

  <!-- ===== BACKGROUND ===== -->
  <rect width="1400" height="900" fill="url(#bg)"/>

  <!-- Subtle dot grid -->
  <pattern id="dots" width="30" height="30" patternUnits="userSpaceOnUse">
    <circle cx="15" cy="15" r="0.7" fill="#3ec4d8" opacity="0.09"/>
  </pattern>
  <rect width="1400" height="900" fill="url(#dots)"/>

  <!-- ===== ORBIT RINGS around center ===== -->
  <g transform="translate(700, 450)">
    <!-- Outer decorative rings -->
    <circle cx="0" cy="0" r="290" fill="none" stroke="#3ec4d8" stroke-width="0.6" stroke-dasharray="4,12" opacity="0.18" class="ring-pulse"/>
    <circle cx="0" cy="0" r="220" fill="none" stroke="#4fdbaa" stroke-width="0.6" stroke-dasharray="3,10" opacity="0.15" class="ring-pulse"/>
    <circle cx="0" cy="0" r="150" fill="none" stroke="#3ec4d8" stroke-width="0.5" stroke-dasharray="2,8"  opacity="0.20" class="ring-pulse"/>
    <!-- Hub glow halos -->
    <circle cx="0" cy="0" r="62"  fill="#3ec4d8" opacity="0.12">
      <animate attributeName="r" values="62;78;62" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.12;0.04;0.12" dur="3s" repeatCount="indefinite"/>
    </circle>
    <circle cx="0" cy="0" r="90"  fill="#3ec4d8" opacity="0.07">
      <animate attributeName="r" values="90;110;90" dur="3s" begin="0.5s" repeatCount="indefinite"/>
      <animate attributeName="opacity" values="0.07;0.02;0.07" dur="3s" begin="0.5s" repeatCount="indefinite"/>
    </circle>
  </g>

  <!-- ===== CONNECTOR ARMS from center to nodes ===== -->
  <!-- Static base lines -->
  <!-- Voice — top left -->
  <line x1="700" y1="450" x2="310" y2="220" stroke="#3ec4d8" stroke-width="1.5" opacity="0.2"/>
  <line x1="700" y1="450" x2="310" y2="220" stroke="#3ec4d8" stroke-width="2" stroke-dasharray="18,18" class="flow1" opacity="0.7"/>

  <!-- Video — top right -->
  <line x1="700" y1="450" x2="1090" y2="220" stroke="#4fdbaa" stroke-width="1.5" opacity="0.2"/>
  <line x1="700" y1="450" x2="1090" y2="220" stroke="#4fdbaa" stroke-width="2" stroke-dasharray="18,18" class="flow2" opacity="0.7"/>

  <!-- Messaging — bottom left -->
  <line x1="700" y1="450" x2="310" y2="680" stroke="#3ec4d8" stroke-width="1.5" opacity="0.2"/>
  <line x1="700" y1="450" x2="310" y2="680" stroke="#3ec4d8" stroke-width="2" stroke-dasharray="18,18" class="flow3" opacity="0.7"/>

  <!-- Mobile — bottom right -->
  <line x1="700" y1="450" x2="1090" y2="680" stroke="#4fdbaa" stroke-width="1.5" opacity="0.2"/>
  <line x1="700" y1="450" x2="1090" y2="680" stroke="#4fdbaa" stroke-width="2" stroke-dasharray="18,18" class="flow4" opacity="0.7"/>

  <!-- Remote worker — far left -->
  <line x1="700" y1="450" x2="165" y2="450" stroke="#3ec4d8" stroke-width="1.5" opacity="0.15"/>
  <line x1="700" y1="450" x2="165" y2="450" stroke="#3ec4d8" stroke-width="1.5" stroke-dasharray="14,14" class="flow5" opacity="0.5"/>

  <!-- Multi-location — far right -->
  <line x1="700" y1="450" x2="1235" y2="450" stroke="#4fdbaa" stroke-width="1.5" opacity="0.15"/>
  <line x1="700" y1="450" x2="1235" y2="450" stroke="#4fdbaa" stroke-width="1.5" stroke-dasharray="14,14" class="flow6" opacity="0.5"/>

  <!-- Top center: QoS/cloud -->
  <line x1="700" y1="450" x2="700" y2="165" stroke="#4fdbaa" stroke-width="1.5" opacity="0.15"/>
  <line x1="700" y1="450" x2="700" y2="165" stroke="#4fdbaa" stroke-width="1.5" stroke-dasharray="14,14" class="flow7" opacity="0.5"/>

  <!-- Bottom center: PBX legacy -->
  <line x1="700" y1="450" x2="700" y2="735" stroke="#3ec4d8" stroke-width="1.5" opacity="0.15"/>
  <line x1="700" y1="450" x2="700" y2="735" stroke="#3ec4d8" stroke-width="1.5" stroke-dasharray="14,14" class="flow8" opacity="0.5"/>

  <!-- ===== CENTRAL HUB ===== -->
  <g transform="translate(700, 450)" filter="url(#glow-hub)">
    <!-- Hub background disc -->
    <circle cx="0" cy="0" r="58" fill="url(#panelGrad)" stroke="#4fdbaa" stroke-width="2.5"/>
    <!-- Inner ring -->
    <circle cx="0" cy="0" r="44" fill="none" stroke="#3ec4d8" stroke-width="1" opacity="0.5"/>
    <!-- Icon: unified comms symbol — overlapping speech bubbles -->
    <!-- Left bubble -->
    <path d="M -20 -14 Q -20 -26 -8 -26 Q 4 -26 4 -14 Q 4 -2 -8 -2 L -14 4 L -12 -2 Q -20 -2 -20 -14 Z"
          fill="none" stroke="#4fdbaa" stroke-width="1.8" stroke-linejoin="round"/>
    <!-- Right bubble -->
    <path d="M 2 -8 Q 2 -20 14 -20 Q 26 -20 26 -8 Q 26 4 14 4 L 20 10 L 18 4 Q 26 4 26 -8 Q 26 -8 2 -8 Z"
          fill="none" stroke="#3ec4d8" stroke-width="1.8" stroke-linejoin="round"/>
    <!-- Center dot -->
    <circle cx="0" cy="0" r="5" fill="#4fdbaa" class="blink"/>
    <!-- Hub label -->
    <text y="26" text-anchor="middle" font-family="Poppins, sans-serif" font-size="7.5" font-weight="700" fill="#4fdbaa" letter-spacing="1">UNIFIED</text>
    <text y="38" text-anchor="middle" font-family="Poppins, sans-serif" font-size="7.5" font-weight="700" fill="#3ec4d8" letter-spacing="1">PLATFORM</text>
  </g>

  <!-- ===== CHANNEL NODES ===== -->

  <!-- VOICE NODE — Top Left -->
  <g class="node-float" style="transform-origin: 310px 220px;">
    <g filter="url(#shadow)">
      <circle cx="310" cy="220" r="52" fill="url(#panelGrad)" stroke="#3ec4d8" stroke-width="2"/>
      <circle cx="310" cy="220" r="40" fill="none" stroke="#3ec4d8" stroke-width="0.7" opacity="0.4"/>
      <!-- Phone handset icon -->
      <path d="M 294 207 Q 292 200 298 196 L 304 194 Q 307 194 308 197 L 310 203 Q 311 206 308 207 Q 305 211 308 215 Q 312 220 316 218 Q 318 215 321 216 L 327 218 Q 330 219 330 222 L 329 228 Q 328 234 321 232 Q 305 228 296 212 Q 292 208 294 207 Z"
            fill="none" stroke="#3ec4d8" stroke-width="2" stroke-linejoin="round"/>
      <!-- Waveform bars beside phone -->
      <rect x="335" y="213" width="3" height="14" rx="1.5" fill="#3ec4d8" opacity="0.5" class="blink"/>
      <rect x="341" y="209" width="3" height="22" rx="1.5" fill="#3ec4d8" opacity="0.7" class="blink2"/>
      <rect x="347" y="212" width="3" height="16" rx="1.5" fill="#3ec4d8" opacity="0.5" class="blink3"/>
      <circle cx="310" cy="220" r="5" fill="#3ec4d8" class="blink" filter="url(#glow-soft)"/>
    </g>
    <text x="310" y="287" text-anchor="middle" font-family="Poppins, sans-serif" font-size="12" font-weight="700" fill="#3ec4d8">Voice</text>
    <text x="310" y="304" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">Crystal-clear VoIP</text>
    <text x="310" y="319" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">with QoS priority</text>
  </g>

  <!-- VIDEO NODE — Top Right -->
  <g class="node-float2" style="transform-origin: 1090px 220px;">
    <g filter="url(#shadow)">
      <circle cx="1090" cy="220" r="52" fill="url(#panelGrad)" stroke="#4fdbaa" stroke-width="2"/>
      <circle cx="1090" cy="220" r="40" fill="none" stroke="#4fdbaa" stroke-width="0.7" opacity="0.4"/>
      <!-- Video camera icon -->
      <rect x="1068" y="208" width="28" height="22" rx="3" fill="none" stroke="#4fdbaa" stroke-width="2"/>
      <path d="M 1096 213 L 1110 207 L 1110 233 L 1096 227 Z" fill="none" stroke="#4fdbaa" stroke-width="2" stroke-linejoin="round"/>
      <circle cx="1076" cy="219" r="3" fill="#4fdbaa" class="blink2" filter="url(#glow-soft)"/>
      <!-- Signal dots -->
      <circle cx="1107" cy="212" r="2.5" fill="#4fdbaa" class="blink"/>
      <circle cx="1107" cy="219" r="2.5" fill="#4fdbaa" class="blink3"/>
      <circle cx="1107" cy="226" r="2.5" fill="#4fdbaa" class="blink2"/>
    </g>
    <text x="1090" y="287" text-anchor="middle" font-family="Poppins, sans-serif" font-size="12" font-weight="700" fill="#4fdbaa">Video</text>
    <text x="1090" y="304" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">HD conferencing</text>
    <text x="1090" y="319" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">any device</text>
  </g>

  <!-- MESSAGING NODE — Bottom Left -->
  <g class="node-float3" style="transform-origin: 310px 680px;">
    <g filter="url(#shadow)">
      <circle cx="310" cy="680" r="52" fill="url(#panelGrad)" stroke="#3ec4d8" stroke-width="2"/>
      <circle cx="310" cy="680" r="40" fill="none" stroke="#3ec4d8" stroke-width="0.7" opacity="0.4"/>
      <!-- Chat bubble icon -->
      <path d="M 288 665 Q 288 653 300 653 L 330 653 Q 342 653 342 665 Q 342 677 330 677 L 310 677 L 302 687 L 304 677 Q 288 677 288 665 Z"
            fill="none" stroke="#3ec4d8" stroke-width="2" stroke-linejoin="round"/>
      <!-- Message lines inside -->
      <line x1="297" y1="663" x2="333" y2="663" stroke="#3ec4d8" stroke-width="1.5" opacity="0.6"/>
      <line x1="297" y1="670" x2="325" y2="670" stroke="#3ec4d8" stroke-width="1.5" opacity="0.4"/>
      <circle cx="310" cy="680" r="5" fill="#3ec4d8" class="blink3" filter="url(#glow-soft)"/>
    </g>
    <text x="310" y="747" text-anchor="middle" font-family="Poppins, sans-serif" font-size="12" font-weight="700" fill="#3ec4d8">Messaging</text>
    <text x="310" y="764" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">Team chat &amp;</text>
    <text x="310" y="779" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">collaboration</text>
  </g>

  <!-- MOBILE NODE — Bottom Right -->
  <g class="node-float4" style="transform-origin: 1090px 680px;">
    <g filter="url(#shadow)">
      <circle cx="1090" cy="680" r="52" fill="url(#panelGrad)" stroke="#4fdbaa" stroke-width="2"/>
      <circle cx="1090" cy="680" r="40" fill="none" stroke="#4fdbaa" stroke-width="0.7" opacity="0.4"/>
      <!-- Mobile phone icon -->
      <rect x="1078" y="656" width="24" height="40" rx="4" fill="none" stroke="#4fdbaa" stroke-width="2"/>
      <line x1="1078" y1="664" x2="1102" y2="664" stroke="#4fdbaa" stroke-width="1" opacity="0.5"/>
      <line x1="1078" y1="686" x2="1102" y2="686" stroke="#4fdbaa" stroke-width="1" opacity="0.5"/>
      <circle cx="1090" cy="691" r="2.5" fill="#4fdbaa" class="blink4"/>
      <!-- Signal arcs on phone -->
      <path d="M 1108 668 Q 1114 672 1108 676" fill="none" stroke="#4fdbaa" stroke-width="1.5" stroke-linecap="round" opacity="0.7" class="blink"/>
      <path d="M 1111 664 Q 1120 672 1111 680" fill="none" stroke="#4fdbaa" stroke-width="1.2" stroke-linecap="round" opacity="0.5" class="blink2"/>
    </g>
    <text x="1090" y="747" text-anchor="middle" font-family="Poppins, sans-serif" font-size="12" font-weight="700" fill="#4fdbaa">Mobile</text>
    <text x="1090" y="764" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">Work from anywhere</text>
    <text x="1090" y="779" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">any device</text>
  </g>

  <!-- REMOTE WORKER — Far Left -->
  <g class="float2" style="transform-origin: 130px 450px;" filter="url(#shadow)">
    <circle cx="130" cy="450" r="42" fill="url(#panelGrad)" stroke="#3ec4d8" stroke-width="1.8"/>
    <!-- Person silhouette -->
    <circle cx="130" cy="434" r="10" fill="none" stroke="#3ec4d8" stroke-width="1.8"/>
    <path d="M 108 468 Q 108 454 130 454 Q 152 454 152 468" fill="none" stroke="#3ec4d8" stroke-width="1.8" stroke-linecap="round"/>
    <!-- Home icon below person -->
    <path d="M 118 476 L 130 468 L 142 476 L 142 485 L 118 485 Z" fill="none" stroke="#3ec4d8" stroke-width="1.2" opacity="0.5"/>
    <circle cx="130" cy="450" r="4" fill="#3ec4d8" class="blink2" filter="url(#glow-soft)"/>
    <text x="130" y="508" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" font-weight="600" fill="#3ec4d8">Remote</text>
    <text x="130" y="521" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">Worker</text>
  </g>

  <!-- MULTI-LOCATION — Far Right -->
  <g class="float3" style="transform-origin: 1270px 450px;" filter="url(#shadow)">
    <circle cx="1270" cy="450" r="42" fill="url(#panelGrad)" stroke="#4fdbaa" stroke-width="1.8"/>
    <!-- Building group icon -->
    <rect x="1248" y="434" width="18" height="24" rx="2" fill="none" stroke="#4fdbaa" stroke-width="1.6"/>
    <rect x="1270" y="438" width="14" height="20" rx="2" fill="none" stroke="#4fdbaa" stroke-width="1.4" opacity="0.7"/>
    <rect x="1287" y="442" width="12" height="16" rx="2" fill="none" stroke="#4fdbaa" stroke-width="1.2" opacity="0.5"/>
    <!-- Windows -->
    <rect x="1252" y="439" width="4" height="4" fill="#4fdbaa" opacity="0.5" class="blink"/>
    <rect x="1259" y="439" width="4" height="4" fill="#4fdbaa" opacity="0.5" class="blink2"/>
    <rect x="1252" y="447" width="4" height="4" fill="#4fdbaa" opacity="0.5" class="blink3"/>
    <circle cx="1270" cy="450" r="4" fill="#4fdbaa" class="blink" filter="url(#glow-soft)"/>
    <text x="1270" y="508" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" font-weight="600" fill="#4fdbaa">Multi-Site</text>
    <text x="1270" y="521" text-anchor="middle" font-family="Poppins, sans-serif" font-size="10" fill="#2a9fb5">Locations</text>
  </g>

  <!-- QoS / CLOUD — Top Center -->
  <g class="float" style="transform-origin: 700px 130px;" filter="url(#shadow)">
    <circle cx="700" cy="130" r="42" fill="url(#panelGrad)" stroke="#4fdbaa" stroke-width="1.8"/>
    <!-- Cloud icon -->
    <path d="M 676 134 Q 672 122 682 118 Q 685 110 696 110 Q 702 104 712 106 Q 722 104 726 114 Q 736 114 736 124 Q 736 134 724 134 Z"
          fill="none" stroke="#4fdbaa" stroke-width="1.8"/>
    <!-- QoS bars below cloud -->
    <rect x="690" y="136" width="4" height="6"  rx="1" fill="#4fdbaa" opacity="0.5"/>
